TELEGRAM_BOT_TOKEN=replace_with_token_from_BotFather
# Optional: comma-separated numeric Telegram user IDs. Empty permits all private users.
ALLOWED_USER_IDS=
DATABASE_PATH=data/tracking.sqlite3
TIMEZONE=Asia/Ho_Chi_Minh
POLL_INTERVAL_SECONDS=60
REQUEST_DELAY_MIN=1
REQUEST_DELAY_MAX=3
HTTP_TIMEOUT_SECONDS=20
HTTP_BACKEND=curl_cffi
MAX_ORDERS_PER_CHAT=50
SPX_API_URL=https://spx.vn/shipment/order/open/order/get_order_info
JNT_TRACKING_URL=https://jtexpress.vn/vi/tracking
CARRIER_CONFIG_PATH=config/carriers.json
LOG_LEVEL=INFO
